# Скопируйте в .env (он не коммитится) и впишите свой ключ.
# Ключ: https://console.mistral.ai -> API Keys (бесплатного тарифа Experiment достаточно)
MISTRAL_API_KEY=

# Необязательно:
# MISTRAL_MODEL=mistral-small-latest        # модель ответов; mistral-medium-latest — сильнее и медленнее
# MISTRAL_TEMPERATURE=0.1
# MISTRAL_MAX_TOKENS=1200
# MISTRAL_JUDGE_MODEL=mistral-small-latest  # судья Ragas в eval_rag.py

# Qdrant и модели поиска
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=nasa_llis
# FASTEMBED_CACHE_PATH=.fastembed_cache

# Параметры поиска (любое поле RetrieverConfig): HOUSTON_<ИМЯ>
# HOUSTON_FINAL_K=5
# HOUSTON_USE_RERANKER=true
